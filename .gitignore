# Never commit session/cookie dumps
cookies.txt
*.cookies

# ECS task definitions are generated at deploy time by ci.yml (and
# scripts/deploy_cloudflared_tunnel.sh), not authored here. Committing them
# produces files that look authoritative but drift from what is actually
# running — read the live definition with `aws ecs describe-task-definition`
# instead.
task-def-*.json
task-def-*-arn.txt

# Local runtime artifacts
.cache/
celerybeat-schedule
celerybeat-schedule*
celery.log
*.db
